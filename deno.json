{
  "tasks": {
    "check": "deno check packages/markspec/main.ts packages/markspec/core/mod.ts packages/markspec/lsp/server.ts packages/markspec/mcp/server.ts",
    "compile": "deno run --allow-read --allow-write --allow-run --allow-env scripts/compile_binary.ts --output markspec",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-ffi",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fetch-grammars": "deno run --allow-net --allow-write --allow-read scripts/fetch_grammars.ts",
    "eval:gen": "deno run --allow-write --allow-read eval/sqlite-indexing/corpus/generate_cli.ts",
    "eval:bench:cold": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net eval/sqlite-indexing/bench/cold_scan.ts",
    "eval:bench:warm": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net eval/sqlite-indexing/bench/warm_incremental.ts",
    "eval:bench:lookups": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net eval/sqlite-indexing/bench/lookups.ts",
    "eval:bench:size": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net eval/sqlite-indexing/bench/size.ts",
    "eval:bench:all": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net --allow-run eval/sqlite-indexing/run.ts",
    "eval:concurrency:wal": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net --allow-run eval/sqlite-indexing/concurrency/wal_contention.ts",
    "eval:concurrency:kill": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net --allow-run eval/sqlite-indexing/concurrency/kill_recovery.ts",
    "eval:concurrency:schema": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net eval/sqlite-indexing/concurrency/schema_mismatch.ts",
    "eval:report": "deno run --allow-read --allow-write eval/sqlite-indexing/report.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/jsonc": "jsr:@std/jsonc@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "@std/ulid": "jsr:@std/ulid@^1",
    "@std/toml": "jsr:@std/toml@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "workspace": [
    "./packages/markspec"
  ],
  "fmt": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.mjs",
      "**/*.cjs"
    ]
  },
  "test": {
    "exclude": [
      "editors/",
      "eval/",
      ".worktrees/",
      ".claude/worktrees/"
    ]
  },
  "lint": {
    "exclude": [
      "editors/",
      "eval/",
      ".worktrees/",
      ".claude/worktrees/"
    ]
  }
}
