# Dependencies
node_modules/

# Build output
dist/
build/
target/
_site/
npm/
*.pdf

# Compile-time WASM mirrors (see scripts/compile_binary.ts)
*.wasm.bin

# Tree-sitter grammar WASM — fetched at build time, not committed.
# Run `deno task fetch-grammars` (bootstrap does this automatically); the
# pinned versions + hashes live in grammars/grammars.lock.
grammars/*.wasm

# Deno
.deno/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
*.sublime-workspace

# dprint
.dprint/

# Claude Code local state (per-developer worktrees and settings)
.claude/

# Superpowers handoff documents (per-developer, regenerated)
docs/superpowers/

# Scratch files (per-developer, temporary)
.scratch/

# Git worktrees (per-developer, not tracked)
.worktrees/

# MarkSpec LSP event log (per-project, regenerated each session)
.markspec/lsp.log*
