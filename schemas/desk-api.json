{
  "openapi": "3.1.0",
  "info": {
    "title": "MarkDesk API",
    "version": "3",
    "description": "Loopback API served by `markspec desk --serve` for the MarkDesk app (ADR-035). The UI's typed client is generated from this document. Reads: product tree, entries, rendered documents, rendered entries, and project source text. Proposals: an assistant proposal for the body of one entry is previewed (no write) and applied; only an apply writes, and it changes only that entry's body. On start the server prints one JSON line to stdout, {\"url\", \"token\", \"apiVersion\", \"root\"}, where root is the absolute, symlink-resolved product root; every request except an allowed-origin CORS preflight carries that token as a bearer credential, and every request carries a loopback Host header. Browser clients must also send an allowed Origin: `tauri://localhost`, `http://tauri.localhost`, `https://tauri.localhost`, plus any `--allow-origin` values."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "0"
        }
      }
    }
  ],
  "security": [
    {
      "nonce": []
    }
  ],
  "paths": {
    "/api/v1/tree": {
      "options": {
        "operationId": "preflightTree",
        "summary": "CORS preflight",
        "description": "Answered before the bearer check, so the browser can learn which headers the real request may carry. Only an OPTIONS request that carries an Origin header is a preflight; an OPTIONS request without Origin is not, and gets 401 (no valid token) or 405 (valid token).",
        "security": [],
        "responses": {
          "204": {
            "description": "Preflight accepted for an allowed Origin",
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "The request Origin, echoed.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "description": "`GET, POST, OPTIONS`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "description": "`Authorization, Content-Type, If-Match, If-None-Match`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Max-Age": {
                "description": "`600` seconds.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "getTree",
        "summary": "The product tree",
        "description": "Entries read top-down through refinement (Satisfies, Derived-from) and verification (Verifies) links. The response is a flat graph: `nodes` lists every entry once, `edges` lists one edge per (child, parent) pair, and `roots` lists the entries with no parent, then the lowest display ID of each link cycle that has no parent outside the cycle. Clients expand the graph from `roots` through the edges. Edges can form a cycle (a link cycle in the project); a client that walks the edges must track the entries it has already visited. The 200 response carries a strong ETag computed from the serialized tree; adding or removing an entry, changing its title, type, or origin, or changing its Satisfies, Derived-from, or Verifies links changes it. Other attributes are not in the tree and keep the tag. A request whose If-None-Match names the current tag gets 304 with no body. Browser clients can read the ETag header: every response to an allowed Origin carries `Access-Control-Expose-Headers: ETag`.",
        "responses": {
          "200": {
            "description": "The product tree",
            "headers": {
              "ETag": {
                "description": "Strong entity tag of this tree: a quoted SHA-256 hex digest.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTree"
                }
              }
            }
          },
          "304": {
            "description": "The tree named by If-None-Match is current. No body.",
            "headers": {
              "ETag": {
                "description": "Strong entity tag of this tree: a quoted SHA-256 hex digest.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "The ETag of the tree the client holds. `*` and a comma-separated list are accepted; a `W/` prefix is ignored.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
