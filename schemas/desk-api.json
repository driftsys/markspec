      "get": {
        "operationId": "getDocument",
        "summary": "One rendered document",
        "description": "Renders a project Markdown file that holds at least one project entry to an HTML fragment. Display IDs of entries in the graph become cross-reference spans. The 200 response carries a strong ETag computed from the document text, the path, the entries of the file, and all display IDs in the graph. A title edit in another file keeps the tag; adding or removing any entry changes it. A request whose If-None-Match names the current tag gets 304 with no body, and the server does not render the document. Browser clients can read the ETag header: every response to an allowed Origin carries `Access-Control-Expose-Headers: ETag`.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "Project-relative path with `/` separators.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "The ETag of the render the client holds. `*` and a comma-separated list are accepted; a `W/` prefix is ignored.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rendered document",
            "headers": {
              "ETag": {
                "description": "Strong entity tag of this render: a quoted SHA-256 hex digest.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentView"
                }
              }
            }
          },
          "304": {
            "description": "The render named by If-None-Match is current. No body.",
            "headers": {
              "ETag": {
                "description": "Strong entity tag of this render: a quoted SHA-256 hex digest.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            }
          },
          "400": {
            "description": "`path` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The path is not a Markdown file holding project entries (including any path outside the project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
