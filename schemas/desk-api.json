          }
        }
      },
      "post": {
        "operationId": "applyProposal",
        "summary": "Apply a proposal",
        "description": "The request carries exactly one change of kind `body` for a project entry (no origin) in a Markdown file. `If-Match` must name the current `/documents` ETag of the entry's file; the comparison is strong (RFC 9110 §13.1.1), so a `W/` tag and `*` never match. The proposed body passes the `markspec fmt` formatter. Checks run in this order: If-Match present (428), request size (422 `proposal-too-large` for a request body over 124 096 bytes), request shape (400), entry exists (404 `entry-not-found`), entry has no origin (409 `entry-read-only`), entry is in a `.md` file (409 `entry-not-markdown`), the file is an allowed project path (404 `not-found`), the file is valid UTF-8 (409 `entry-file-not-utf8`), If-Match names the current tag (412 `precondition-failed`), then the proposal itself: 409 `entry-body-empty` or `entry-trailer-invalid`, 422 `proposal-empty`, `proposal-too-large` (body over 20 000 UTF-16 code units, before or after formatting), `proposal-changes-entries`, or `format-failed`. Writes the file atomically with only the target entry's body replaced by the proposed body exactly as sent, which the UI takes from the preview; every other byte stays unchanged. When formatting the sent body changes it or raises `MSL-F900` (the formatter is not idempotent on its own output), apply writes the sent body unchanged if it passes the length limit and the entry-identity checks. Applies run one at a time, so a second apply with the same tag answers 412 and writes nothing. Just before the write, apply reads the file again and answers 412 `precondition-failed`, writing nothing, when its bytes changed since the check. The response carries the new document ETag in the body and in the ETag header.",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The document ETag the client read before asking the assistant. Compared strongly; a comma-separated list is accepted.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The file was written with only the target body replaced.",
            "headers": {
              "ETag": {
                "description": "The new strong entity tag of the written document: a quoted SHA-256 hex digest, equal to `etag` in the body.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalApplied"
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON of the ProposalRequest shape (`bad-request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "No entry with that display ID or Id (`entry-not-found`), or its file is not an allowed project path (`not-found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The method is not POST (`method-not-allowed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The entry cannot take a proposal: `entry-read-only`, `entry-not-markdown`, `entry-file-not-utf8`, `entry-body-empty`, or `entry-trailer-invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "If-Match does not name the current document ETag, or the file changed before the write (`precondition-failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The proposal is refused: `proposal-empty`, `proposal-too-large`, `proposal-changes-entries`, or `format-failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "If-Match is missing (`precondition-required`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The file could not be written (`write-failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "nonce": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-launch token from the server's stdout handshake."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Host is not loopback, or Origin is not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ProductTree": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "project",
          "roots",
          "nodes",
          "edges"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "project": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "`project.yaml` name, when present."
              }
            }
          },
          "roots": {
            "type": "array",
            "description": "Display IDs of the entries with no parent, sorted, then the lowest display ID of each link cycle that has no parent outside the cycle.",
            "items": {
              "type": "string"
            }
          },
          "nodes": {
            "type": "array",
            "description": "Every entry once, sorted by display ID.",
            "items": {
              "$ref": "#/components/schemas/ProductNode"
            }
          },
          "edges": {
            "type": "array",
            "description": "One edge per (child, parent) pair, sorted by parent, then refinement before verification, then child. Edges can form a cycle (a link cycle in the project); a client that walks the edges must track the entries it has already visited.",
            "items": {
              "$ref": "#/components/schemas/ProductEdge"
            }
          }
        }
      },
      "ProductNode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayId",
          "title"
        ],
        "properties": {
          "displayId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Profile type name, when classified."
          },
          "kind": {
            "type": "string",
            "description": "Core type the profile type extends: Requirement, Risk, Test, Contract, …"
          },
          "origin": {
            "type": "string",
            "description": "`<profile-id>@<version>` for delivered-corpus entries."
          }
        }
      },
      "ProductEdge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "type": "string",
            "description": "Display ID of the refining or verifying entry (the child)."
          },
          "to": {
            "type": "string",
            "description": "Display ID of the link target (the parent)."
          },
          "relation": {
            "type": "string",
            "description": "Link kind.",
            "enum": [
              "satisfies",
              "derived-from",
              "verifies"
            ]
          }
        }
      },
      "EntryView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "displayId",
          "title",
          "body",
          "attributes",
          "location",
          "links"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "displayId": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The `Id:` value (ULID or URI), when stamped."
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "description": "Trailer attributes in authored order.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "line",
              "column"
            ],
            "properties": {
              "file": {
                "type": "string",
                "description": "Path relative to the project root."
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "origin": {
            "type": "string"
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outgoing",
              "incoming"
            ],
            "properties": {
              "outgoing": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LinkView"
                }
              },
              "incoming": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LinkView"
                }
              }
            }
          }
        }
      },
      "LinkView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "displayId"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "displayId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Title of the linked entry, when it is in the graph."
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "DocumentView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "path",
          "html",
          "entries"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "path": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "description": "Rendered HTML fragment. Entry blocks carry `id=\"entry-<displayId>\"` and `data-display-id`."
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "displayId",
                "anchor"
              ],
              "properties": {
                "displayId": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string",
                  "description": "Element id of the entry block, `entry-<displayId>`."
                }
              }
            }
          }
        }
      },
      "EntryHtmlView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "displayId",
          "html"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "displayId": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          }
        }
      },
      "SourceText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "path",
          "text"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ProposalChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayId",
          "kind",
          "body"
        ],
        "properties": {
          "displayId": {
            "type": "string",
            "minLength": 1,
            "description": "Display ID or `Id:` value of the target entry."
          },
          "kind": {
            "const": "body",
            "description": "What the change replaces. Only `body` exists."
          },
          "body": {
            "type": "string",
            "description": "The proposed body, without indentation."
          }
        }
      },
      "ProposalRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changes"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "description": "Exactly one change.",
            "items": {
              "$ref": "#/components/schemas/ProposalChange"
            }
          }
        }
      },
      "PreviewedChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayId",
          "kind",
          "body",
          "currentBody"
        ],
        "properties": {
          "displayId": {
            "type": "string",
            "description": "Display ID of the target entry."
          },
          "kind": {
            "const": "body"
          },
          "body": {
            "type": "string",
            "description": "The proposed body as `markspec fmt` writes it (dedented, LF line endings)."
          },
          "currentBody": {
            "type": "string",
            "description": "The current body, formatted when the formatted form holds the same words as the body on disk, otherwise as written on disk (dedented, LF line endings)."
          }
        }
      },
      "ProposalPreview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "changes"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreviewedChange"
            }
          }
        }
      },
      "ProposalApplied": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "path",
          "etag"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "path": {
            "type": "string",
            "description": "Project-relative path of the written file, with `/` separators."
          },
          "etag": {
            "type": "string",
            "pattern": "^\"[0-9a-f]{64}\"$",
            "description": "The new document ETag of the written file."
          }
        }
      }
    }
  }
}
