{
  "openapi": "3.1.0",
  "info": {
    "title": "MarkDesk API",
    "version": "3",
    "description": "Loopback API served by `markspec desk --serve` for the MarkDesk app (ADR-035). The UI's typed client is generated from this document. Read-only: product tree, entries, rendered documents, rendered entries, and project source text. On start the server prints one JSON line to stdout, {\"url\", \"token\", \"apiVersion\"}; every request except an allowed-origin CORS preflight carries that token as a bearer credential, and every request carries a loopback Host header. Browser clients must also send an allowed Origin: `tauri://localhost`, `http://tauri.localhost`, `https://tauri.localhost`, plus any `--allow-origin` values."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "0"
        }
      }
    }
  ],
  "security": [
    {
      "nonce": []
    }
  ],
  "paths": {
    "/api/v1/tree": {
      "options": {
        "operationId": "preflightTree",
        "summary": "CORS preflight",
        "description": "Answered before the bearer check, so the browser can learn which headers the real request may carry. Only an OPTIONS request that carries an Origin header is a preflight; an OPTIONS request without Origin is not, and gets 401 (no valid token) or 405 (valid token).",
        "security": [],
        "responses": {
          "204": {
            "description": "Preflight accepted for an allowed Origin",
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "The request Origin, echoed.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "description": "`GET, OPTIONS`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "description": "`Authorization`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Max-Age": {
                "description": "`600` seconds.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "getTree",
        "summary": "The product tree",
        "description": "Entries read top-down through refinement (Satisfies, Derived-from) and verification (Verifies) links. The response is a flat graph: `nodes` lists every entry once, `edges` lists one edge per (child, parent) pair, and `roots` lists the entries with no parent, then the lowest display ID of each link cycle that has no parent outside the cycle. Clients expand the graph from `roots` through the edges. Edges can form a cycle (a link cycle in the project); a client that walks the edges must track the entries it has already visited.",
        "responses": {
          "200": {
            "description": "The product tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTree"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/entries/{id}": {
      "options": {
        "operationId": "preflightEntry",
        "summary": "CORS preflight",
        "description": "Answered before the bearer check, so the browser can learn which headers the real request may carry. Only an OPTIONS request that carries an Origin header is a preflight; an OPTIONS request without Origin is not, and gets 401 (no valid token) or 405 (valid token).",
        "security": [],
        "responses": {
          "204": {
            "description": "Preflight accepted for an allowed Origin",
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "The request Origin, echoed.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "description": "`GET, OPTIONS`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "description": "`Authorization`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Max-Age": {
                "description": "`600` seconds.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "getEntry",
        "summary": "One entry",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Display ID (`STK_BRK_0001`) or `Id:` value (ULID or URI), percent-encoded.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The entry and its links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryView"
                }
              }
            }
          },
          "400": {
            "description": "The id is not valid percent-encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "No entry with that display ID or Id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "options": {
        "operationId": "preflightDocuments",
        "summary": "CORS preflight",
        "description": "Answered before the bearer check, so the browser can learn which headers the real request may carry. Only an OPTIONS request that carries an Origin header is a preflight; an OPTIONS request without Origin is not, and gets 401 (no valid token) or 405 (valid token).",
        "security": [],
        "responses": {
          "204": {
            "description": "Preflight accepted for an allowed Origin",
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "The request Origin, echoed.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "description": "`GET, OPTIONS`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "description": "`Authorization`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Max-Age": {
                "description": "`600` seconds.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "getDocument",
        "summary": "One rendered document",
        "description": "Renders a project Markdown file that holds at least one project entry to an HTML fragment. Display IDs of entries in the graph become cross-reference spans.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "Project-relative path with `/` separators.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rendered document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentView"
                }
              }
            }
          },
          "400": {
            "description": "`path` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The path is not a Markdown file holding project entries (including any path outside the project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/entries/{id}/html": {
      "options": {
        "operationId": "preflightEntryHtml",
        "summary": "CORS preflight",
        "description": "Answered before the bearer check, so the browser can learn which headers the real request may carry. Only an OPTIONS request that carries an Origin header is a preflight; an OPTIONS request without Origin is not, and gets 401 (no valid token) or 405 (valid token).",
        "security": [],
        "responses": {
          "204": {
            "description": "Preflight accepted for an allowed Origin",
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "The request Origin, echoed.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "description": "`GET, OPTIONS`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "description": "`Authorization`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Max-Age": {
                "description": "`600` seconds.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "getEntryHtml",
        "summary": "One rendered entry",
        "description": "Renders one entry as the same entry-block markup a document uses. Works for delivered and upstream entries; the response carries `origin` for them.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Display ID or `Id:` value, percent-encoded.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rendered entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryHtmlView"
                }
              }
            }
          },
          "400": {
            "description": "The id is not valid percent-encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "No entry with that display ID or Id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files": {
      "options": {
        "operationId": "preflightFiles",
        "summary": "CORS preflight",
        "description": "Answered before the bearer check, so the browser can learn which headers the real request may carry. Only an OPTIONS request that carries an Origin header is a preflight; an OPTIONS request without Origin is not, and gets 401 (no valid token) or 405 (valid token).",
        "security": [],
        "responses": {
          "204": {
            "description": "Preflight accepted for an allowed Origin",
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "The request Origin, echoed.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "description": "`GET, OPTIONS`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "description": "`Authorization`.",
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Max-Age": {
                "description": "`600` seconds.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "getFile",
        "summary": "Project source text",
        "description": "Returns the text of a Markdown or source file that holds at least one project entry.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "Project-relative path with `/` separators.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceText"
                }
              }
            }
          },
          "400": {
            "description": "`path` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The path is not a file holding project entries (including any path outside the project)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "nonce": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-launch token from the server's stdout handshake."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Host is not loopback, or Origin is not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ProductTree": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "project",
          "roots",
          "nodes",
          "edges"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "project": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "`project.yaml` name, when present."
              }
            }
          },
          "roots": {
            "type": "array",
            "description": "Display IDs of the entries with no parent, sorted, then the lowest display ID of each link cycle that has no parent outside the cycle.",
            "items": {
              "type": "string"
            }
          },
          "nodes": {
            "type": "array",
            "description": "Every entry once, sorted by display ID.",
            "items": {
              "$ref": "#/components/schemas/ProductNode"
            }
          },
          "edges": {
            "type": "array",
            "description": "One edge per (child, parent) pair, sorted by parent, then refinement before verification, then child. Edges can form a cycle (a link cycle in the project); a client that walks the edges must track the entries it has already visited.",
            "items": {
              "$ref": "#/components/schemas/ProductEdge"
            }
          }
        }
      },
      "ProductNode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayId",
          "title"
        ],
        "properties": {
          "displayId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Profile type name, when classified."
          },
          "kind": {
            "type": "string",
            "description": "Core type the profile type extends: Requirement, Risk, Test, Contract, …"
          },
          "origin": {
            "type": "string",
            "description": "`<profile-id>@<version>` for delivered-corpus entries."
          }
        }
      },
      "ProductEdge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "type": "string",
            "description": "Display ID of the refining or verifying entry (the child)."
          },
          "to": {
            "type": "string",
            "description": "Display ID of the link target (the parent)."
          },
          "relation": {
            "type": "string",
            "description": "Link kind.",
            "enum": [
              "satisfies",
              "derived-from",
              "verifies"
            ]
          }
        }
      },
      "EntryView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "displayId",
          "title",
          "body",
          "attributes",
          "location",
          "links"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "displayId": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The `Id:` value (ULID or URI), when stamped."
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "description": "Trailer attributes in authored order.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "line",
              "column"
            ],
            "properties": {
              "file": {
                "type": "string",
                "description": "Path relative to the project root."
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "origin": {
            "type": "string"
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outgoing",
              "incoming"
            ],
            "properties": {
              "outgoing": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LinkView"
                }
              },
              "incoming": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LinkView"
                }
              }
            }
          }
        }
      },
      "LinkView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "displayId"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "displayId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Title of the linked entry, when it is in the graph."
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "DocumentView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "path",
          "html",
          "entries"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "path": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "description": "Rendered HTML fragment. Entry blocks carry `id=\"entry-<displayId>\"` and `data-display-id`."
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "displayId",
                "anchor"
              ],
              "properties": {
                "displayId": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string",
                  "description": "Element id of the entry block, `entry-<displayId>`."
                }
              }
            }
          }
        }
      },
      "EntryHtmlView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "displayId",
          "html"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "displayId": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          }
        }
      },
      "SourceText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "path",
          "text"
        ],
        "properties": {
          "apiVersion": {
            "const": 3
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
